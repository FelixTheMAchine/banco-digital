# INVENTÁRIO DE CONFIGURAÇÃO; não constitui uma implantação pronta.
# Não use o docker-compose.yml local em produção.
# Forneça segredos exclusivos por um gerenciador de segredos, fora do Git.
# Campos vazios são intencionais e precisam de configuração real e revisão.
RAILS_ENV=production
RAILS_LOG_LEVEL=info
SECRET_KEY_BASE=
AR_ENCRYPTION_PRIMARY_KEY=
AR_ENCRYPTION_DETERMINISTIC_KEY=
AR_ENCRYPTION_KEY_DERIVATION_SALT=
APP_HOSTS=api.fintech.example.invalid
APP_ORIGINS=https://fintech.example.invalid
APP_FRONTEND_URL=https://fintech.example.invalid
MAIL_FROM=nao-responda@fintech.example.invalid
# Use usuário de aplicação restrito, servidor confiável e validação TLS completa.
# Exemplo de formato: postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=verify-full
# Codifique caracteres reservados das credenciais conforme regras de URL.
DATABASE_URL=
# Use rediss:// e configure CA confiável para Redis remoto.
REDIS_URL=
SMTP_ADDRESS=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
RUN_DEMO_SEEDS=0
DEMO_PASSWORD=
API_URL=https://api.fintech.example.invalid
WEB_ORIGIN=https://fintech.example.invalid
COOKIE_SECURE=true
