# Somente desenvolvimento local com dinheiro fictício.
# scripts/setup.sh ou scripts/setup.ps1 criam valores aleatórios em .env.
POSTGRES_USER=banco
POSTGRES_PASSWORD=change-me-local-db
POSTGRES_DB=banco_digital_development
POSTGRES_PORT=5432
REDIS_PORT=6379
API_PORT=3001
API_BIND_HOST=127.0.0.1
APP_HOSTS=localhost,127.0.0.1,api,10.0.2.2
WEB_PORT=3000
SECRET_KEY_BASE=change-me-local-secret-generate-before-running
APP_ORIGINS=http://localhost:3000
# Destino dos links de verificação e recuperação nas telas web implementadas.
APP_FRONTEND_URL=http://localhost:3000
MAIL_FROM=nao-responda@banco-digital.example
RAILS_ENV=development
RAILS_LOG_LEVEL=info
# Para Ruby instalado no host; Compose substitui os hosts por postgres/redis.
DATABASE_URL=postgresql://banco:change-me-local-db@localhost:5432/banco_digital_development
TEST_DATABASE_URL=postgresql://banco:change-me-local-db@localhost:5432/banco_digital_test
REDIS_URL=redis://localhost:6379/0
# A carga de usuários fictícios é opt-in. Nunca reutilize uma senha pessoal.
RUN_DEMO_SEEDS=0
DEMO_PASSWORD=
