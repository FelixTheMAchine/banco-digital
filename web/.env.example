# Somente servidor Next. Nunca usar NEXT_PUBLIC para o token ou URL interna.
API_URL=http://localhost:3001
# Origem exata usada na proteção CSRF. Ajuste se mudar a porta ou usar HTTPS.
WEB_ORIGIN=http://localhost:3000
# Exclusivo de HTTP local. Em produção HTTPS, remova a linha ou use true.
COOKIE_SECURE=false
