# Endereço do Rails alcançável PELO dispositivo, sem /api/v1 no final.
# Android Emulator: http://10.0.2.2:3001
# iOS Simulator: http://localhost:3001
# Celular físico: http://IP_LAN_DO_PC:3001 (somente desenvolvimento).
EXPO_PUBLIC_API_URL=http://localhost:3001
# Builds EAS preview/production exigem uma origem HTTPS e APP_VARIANT=production.
# Variáveis EXPO_PUBLIC_* ficam visíveis no bundle; não coloque tokens ou segredos.
